# DeepSeek V3 on Volcano Engine configuration
TAVILY_API_KEY=your_tavily_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DEEPSEEK_MODEL=your_deepseek_model_here

# Set default model to use deepseek
MODEL=deepseek

# RAG Configuration
RAG_PROVIDER=ragflow
RAGFLOW_API_URL="http://your_ragflow_server:port"
RAGFLOW_API_KEY="your_ragflow_api_key_here"

# XHS RAG Configuration
XHS_DATASET_ID="your_dataset_id_here"
XHS_DATASET_IDS=""
XHS_MAX_RESULTS=10
XHS_SIMILARITY_THRESHOLD=0.3